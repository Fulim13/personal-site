---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" zone="portfolio">
  <div class="zone-page">
    <section class="hero" style="padding-top: var(--space-8)">
      <div>
        <p class="hero__tagline">404</p>
        <h1 class="hero__name">Nothing here</h1>
        <p class="hero__intro">
          That page does not exist — it may have moved, or it may never have.
        </p>
        <ul class="hero__links">
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/projects">Projects</a></li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
