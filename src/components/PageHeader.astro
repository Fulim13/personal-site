---
/**
 * The title block for an index page. Used by /blog, /projects and the tag
 * pages so that section headers are identical across both zones — previously
 * /blog centred a 3rem heading while /projects used a left-aligned 2rem one.
 */
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="page-header">
  <h1 class="page-header__title">{title}</h1>
  {lead && <p class="page-header__lead">{lead}</p>}
  <slot />
</header>
