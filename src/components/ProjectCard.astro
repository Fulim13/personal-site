---
import type { Project } from '../lib/content';
import { techTone } from '../lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, blurb, year, tech, repo, url, sourceOnly } = project.data;
---

<li class="project-card">
  <p class="project-card__year">{year}</p>

  <h2 class="project-card__title">
    {title}
  </h2>

  <p class="project-card__blurb">{blurb}</p>

  {
    tech.length > 0 && (
      <ul class="chip-list" aria-label="Built with">
        {tech.map((t) => (
          <li class="tag-chip tag-chip--sm" data-tone={techTone(t)}>
            {t}
          </li>
        ))}
      </ul>
    )
  }

  {/* Project cards expose external links only. */}
  <p class="project-card__links">
    {!sourceOnly && url && <a href={url} rel="noopener">Live</a>}
    {repo && <a href={repo} rel="noopener">Source</a>}
  </p>
</li>
